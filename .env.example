# Omneo Configuration
OMNEO_TENANT=your-tenant
OMNEO_TOKEN=your-omneo-api-token-here
OMNEO_SECRET=your-omneo-webhook-secret

# Development Configuration (Optional)
# Only needed for local development with ngrok.
# VITE_NGROK_DOMAIN keeps the same dev URL across restarts (a reserved ngrok domain).
# Leave blank for deployed environments.
VITE_NGROK_DOMAIN=
NGROK_AUTHTOKEN=
